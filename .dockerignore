# Runtime datasets are preprocessed locally; keep large raw/training files out
# of the build context and include only the API and compact investigation files.
data/*
!data/processed/
data/processed/*
!data/processed/ieee_val_api.parquet
!data/processed/ieee_investigation_context.parquet

# Exclude everything in models except the runtime model and metadata
models/*
!models/ieee_lightgbm_tuned.joblib
!models/ieee_lightgbm_tuned_metadata.json

# Exclude development and MLflow artifacts
mlruns/
mlflow.db
cases.db
.git/
__pycache__/
tests/
notebooks/
reports/
frontend/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/
