# Exclude everything in data except the required runtime datasets
data/*
!data/processed/
data/processed/*
!data/processed/ieee_train.parquet
!data/processed/ieee_val.parquet
!data/processed/ieee_val_api.parquet

# Exclude everything in models except the runtime model and metadata
models/*
!models/ieee_lightgbm_tuned.joblib
!models/ieee_lightgbm_tuned_metadata.json

# Exclude development and MLflow artifacts
mlruns/
mlflow.db
cases.db
.git/
__pycache__/
tests/
notebooks/
reports/
frontend/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/
